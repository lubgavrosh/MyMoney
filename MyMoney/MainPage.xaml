<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
              xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyMoney.ViewModels"
             xmlns:models="clr-namespace:MyMoney.Models"
             x:Class="MyMoney.MainPage"
             x:DataType="vm:TransakcjeViewModel"
             Title="Transakcje">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20" RowSpacing="20">

            <Label Grid.Row="0" Text="Moneyfy" FontSize="32"
               FontAttributes="Bold" HorizontalOptions="Center" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Transakcje}"
                        EmptyView="Nic tu nie ma — dodaj pierwszą transakcję">
            <CollectionView.Header>
                <Label Text="{Binding LiczbaTransakcji, StringFormat='Transakcji: {0}'}"
                       Margin="0,0,0,12" FontSize="18" />
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Transaction">
                    <Border Padding="16" Margin="0,0,0,12"
                            Stroke="Gray" StrokeThickness="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding PokazSzczegolyCommand, Source={RelativeSource AncestorType={x:Type vm:TransakcjeViewModel}}}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding Opis}"
                                   FontSize="18" FontAttributes="Bold" />
                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="{Binding Kategoria}" />
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding Kwota, StringFormat='{0:C}'}"
                                   FontSize="18" />
                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding Data, StringFormat='{0:d MMM yyyy}'}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout Grid.Row="2" HorizontalOptions="Center" Spacing="10">
            <Button Text="Dodaj" Command="{Binding DodajCommand}" />
        </HorizontalStackLayout>

    </Grid>

</ContentPage>
