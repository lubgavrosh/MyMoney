<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MyMoney.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MyMoney"
    Title="MyMoney">

    <TabBar>
    <ShellContent
        Title="Transakcje"
        ContentTemplate="{DataTemplate local:MainPage}"
        Icon="dotnet_bot.png"
        Route="MainPage" />

        <ShellContent Title="O aplikacji"
                      Route="OAplicationPage"
                      Icon="dotnet_bot.png"
                      ContentTemplate="{DataTemplate local:OAplicationPage}" />
    </TabBar>

</Shell>
