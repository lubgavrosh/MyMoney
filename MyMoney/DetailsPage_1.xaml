<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyMoney.ViewModels"
             x:Class="MyMoney.DetailsPage_1"
             x:DataType="vm:SzczegolyViewModel"
             Title="Szczegóły">

    <VerticalStackLayout Padding="20" Spacing="12">
        <Label Text="{Binding Transakcja.Opis}" FontSize="26" FontAttributes="Bold" />
        <Label Text="{Binding Transakcja.Kwota, StringFormat='Kwota: {0:C}'}" FontSize="20" />
        <Label Text="{Binding Transakcja.Typ, StringFormat='Typ: {0}'}" />
        <Label Text="{Binding Transakcja.Kategoria, StringFormat='Kategoria: {0}'}" />
        <Label Text="{Binding Transakcja.Data, StringFormat='Data: {0:d MMMM yyyy}'}" />
        <Button Text="Wróć" Command="{Binding WrocCommand}" />
    </VerticalStackLayout>

</ContentPage>
